			<string>const std = @import(&quot;std&quot;);

const Mode = enum {
    Precision,
    Tracking,
    Flick,
};

fn abs(x: f32) f32 {
    return if (x &lt; 0) -x else x;
}

fn curve(x: f32) f32 {
    var v = x;
    var sign: f32 = 1.0;
    if (v &lt; 0) {
        sign = -1;
        v = -v;
    }
    const y = v * v * (3.0 - 2.0 * v);
    return y * sign;
}

pub const Engine = struct {
    last_x: f32 = 0,
    last_y: f32 = 0,

    vel_x: f32 = 0,
    vel_y: f32 = 0,

    ix: f32 = 0,
    iy: f32 = 0,
    last_ex: f32 = 0,
    last_ey: f32 = 0,

    kx: f32 = 0,
    ky: f32 = 0,
    px: f32 = 0,
    py: f32 = 0,
    init_kx: bool = false,
    init_ky: bool = false,

    ripple_prev_x: f32 = 0,
    ripple_prev_y: f32 = 0,

    noise_phase: f32 = 0,

    pub fn process(self: *Engine, x: f32, y: f32) struct { f32, f32 } {

        var dx = x - self.last_x;
        var dy = y - self.last_y;

        var speed = std.math.sqrt(self.vel_x * self.vel_x + self.vel_y * self.vel_y);

        var mode: Mode = .Tracking;
        if (speed &lt; 0.05) {
            mode = .Precision;
        } else if (speed &gt; 0.4) {
            mode = .Flick;
        }

        const dz = 0.01 + speed * 0.01;

        if (dx &lt; dz and dx &gt; -dz) dx = 0;
        if (dy &lt; dz and dy &gt; -dz) dy = 0;

        self.vel_x += dx * 0.4;
        self.vel_y += dy * 0.4;

        var friction: f32 = 0.92;
        if (mode == .Flick) friction = 0.85;

        self.vel_x *= friction;
        self.vel_y *= friction;

        const vx = self.vel_x;
        const vy = self.vel_y;

        speed = std.math.sqrt(vx * vx + vy * vy);
        const s = 1.0 / (1.0 + std.math.exp(-speed * 3.0));

        var alpha = 0.3 + (0.95 - 0.3) * s;
        if (mode == .Precision) alpha *= 0.6;

        var sx = self.last_x + dx * alpha;
        var sy = self.last_y + dy * alpha;

        var gain = 1.0 + speed * 0.5;
        if (mode == .Precision) gain *= 0.5;

        const kp = 0.9 * gain;
        const kd = 0.12 * gain;

        self.ix += vx;
        if (self.ix &gt; 1) self.ix = 1 else if (self.ix &lt; -1) self.ix = -1;

        self.iy += vy;
        if (self.iy &gt; 1) self.iy = 1 else if (self.iy &lt; -1) self.iy = -1;

        const dpx = vx - self.last_ex;
        const dpy = vy - self.last_ey;

        self.last_ex = vx;
        self.last_ey = vy;

        const px = kp * vx + 0.02 * self.ix + kd * dpx;
        const py = kp * vy + 0.02 * self.iy + kd * dpy;

        if (!self.init_kx) {
            self.kx = sx + px * 0.5;
            self.init_kx = true;
        }
        if (!self.init_ky) {
            self.ky = sy + py * 0.5;
            self.init_ky = true;
        }

        self.px += 0.001;
        const kxg = self.px / (self.px + 0.01);
        self.kx += kxg * ((sx + px * 0.5) - self.kx);
        self.px *= (1.0 - kxg);

        self.py += 0.001;
        const kyg = self.py / (self.py + 0.01);
        self.ky += kyg * ((sy + py * 0.5) - self.ky);
        self.py *= (1.0 - kyg);

        var bx = self.kx * 1.05;
        var by = self.ky * 1.05;

        const angle = std.math.atan2(by, bx);
        const step = std.math.pi / 12.0;

        const snapped = std.math.round(angle / step) * step;
        const mag = std.math.sqrt(bx * bx + by * by);

        const sx2 = std.math.cos(snapped) * mag;
        const sy2 = std.math.sin(snapped) * mag;

        bx += (sx2 - bx) * 0.3;
        by += (sy2 - by) * 0.3;

        const diffx = bx - self.ripple_prev_x;
        const dampx = diffx / (1.0 + abs(diffx) * 10.0);
        bx = self.ripple_prev_x + dampx * 0.1 + diffx * 0.9;

        const diffy = by - self.ripple_prev_y;
        const dampy = diffy / (1.0 + abs(diffy) * 10.0);
        by = self.ripple_prev_y + dampy * 0.1 + diffy * 0.9;

        self.ripple_prev_x = bx;
        self.ripple_prev_y = by;

        bx = bx / (1.0 + abs(bx));
        by = by / (1.0 + abs(by));

        const axis = 0.7 + speed * 0.3;
        if (abs(bx) &gt; abs(by)) {
            by *= axis;
        } else {
            bx *= axis;
        }

        var maxd: f32 = 0.05;
        if (mode == .Flick) maxd = 0.2;

        var dxo = bx - self.last_x;
        if (dxo &gt; maxd) dxo = maxd else if (dxo &lt; -maxd) dxo = -maxd;

        var dyo = by - self.last_y;
        if (dyo &gt; maxd) dyo = maxd else if (dyo &lt; -maxd) dyo = -maxd;

        bx = self.last_x + dxo;
        by = self.last_y + dyo;

        const predx = bx + (bx - self.last_x) * 0.6;
        const predy = by + (by - self.last_y) * 0.6;

        bx = bx * 0.6 + predx * 0.4;
        by = by * 0.6 + predy * 0.4;

        bx = 0.2 * bx + 0.8 * self.last_x;
        by = 0.2 * by + 0.8 * self.last_y;

        bx = 0.1 * bx + 0.9 * self.last_x;
        by = 0.1 * by + 0.9 * self.last_y;

        self.noise_phase += 0.1;
        const noise = std.math.sin(self.noise_phase) * 0.001;

        bx += noise;
        by -= noise;

        bx = curve(bx);
        by = curve(by);

        if (bx &gt; 1) bx = 1 else if (bx &lt; -1) bx = -1;
        if (by &gt; 1) by = 1 else if (by &lt; -1) by = -1;

        self.last_x = bx;
        self.last_y = by;

        return .{ bx, by };
    }
};

pub fn main() void {
    var engine = Engine{};

    var x: f32 = 0.2;
    var y: f32 = 0.1;

    var i: u32 = 0;
    while (i &lt; 20) : (i += 1) {
        x += 0.01;
        y += 0.005;

        const out = engine.process(x, y);
        std.debug.print(&quot;{d} {d}\n&quot;, .{ out[0], out[1] });
    }
}</string>
