			<string>using UnityEngine;
using UMA;
using UMA.CharacterSystem;
using System.Collections;
using System.Collections.Generic;
using System.IO;
using System.Runtime.Serialization.Formatters.Binary;

public class UltimateAvatarManager : MonoBehaviour
{
    [Header(&quot;=== CẤU HÌNH TỔNG THỂ ===&quot;)]
    public string assetBundlePath = &quot;Assets/avatar_bundle.unity3d&quot;; // Đường dẫn bundle
    public string cacheFolder = &quot;AvatarCache&quot;; // Thư mục lưu cache
    public bool autoLoadOnStart = true;

    [Header(&quot;=== GHIM XƯƠNG ===&quot;)]
    public Transform masterControl; // Transform điều khiển (ví dụ: camera)
    public bool pinNeck = true;
    public bool pinHead = true;
    public bool pinSpine = true;
    public bool pinHips = true;

    [Header(&quot;=== TÙY CHỌN NÂNG CAO ===&quot;)]
    public bool useCachedIfExists = true; // Ưu tiên cache
    public bool forceRecreateCache = false; // Buộc tạo cache mới
    public bool logDetailed = true;

    // Thành phần UMA
    private DynamicCharacterAvatar avatar;
    private UMAData umaData;

    // Cache dữ liệu xương
    private Dictionary&lt;string, BoneCacheData&gt; boneCache = new Dictionary&lt;string, BoneCacheData&gt;();

    // Danh sách các constraint đã tạo
    private List&lt;ParentConstraint&gt; activeConstraints = new List&lt;ParentConstraint&gt;();

    // Singleton pattern
    public static UltimateAvatarManager Instance { get; private set; }

    void Awake()
    {
        if (Instance == null) Instance = this;
        else Destroy(gameObject);
        DontDestroyOnLoad(gameObject);

        // Tạo thư mục cache nếu chưa có
        if (!Directory.Exists(cacheFolder))
            Directory.CreateDirectory(cacheFolder);
    }

    void Start()
    {
        if (autoLoadOnStart)
            StartCoroutine(LoadAndSetupAvatar());
    }

    IEnumerator LoadAndSetupAvatar()
    {
        // Bước 1: Tải AssetBundle
        byte[] bundleData = File.ReadAllBytes(assetBundlePath);
        AssetBundleCreateRequest request = AssetBundle.LoadFromMemoryAsync(bundleData);
        yield return request;

        AssetBundle bundle = request.assetBundle;
        if (bundle == null) { Debug.LogError(&quot;Không tải được AssetBundle!&quot;); yield break; }

        // Bước 2: Tìm UMATextRecipe trong bundle
        string[] assetNames = bundle.GetAllAssetNames();
        UMATextRecipe recipe = null;
        foreach (string name in assetNames)
        {
            Object obj = bundle.LoadAsset(name);
            if (obj is UMATextRecipe)
            {
                recipe = obj as UMATextRecipe;
                break;
            }
        }

        if (recipe == null) { Debug.LogError(&quot;Không tìm thấy UMATextRecipe!&quot;); bundle.Unload(false); yield break; }

        // Bước 3: Tạo avatar từ recipe (có hoặc không cache)
        if (avatar == null)
            avatar = gameObject.AddComponent&lt;DynamicCharacterAvatar&gt;();

        // Kiểm tra cache
        string cacheKey = recipe.name + &quot;_&quot; + recipe.raceData.raceName;
        string cachePath = Path.Combine(cacheFolder, cacheKey + &quot;.dat&quot;);

        if (useCachedIfExists &amp;&amp; File.Exists(cachePath) &amp;&amp; !forceRecreateCache)
        {
            // Load từ cache
            LoadCache(cachePath);
            // Áp dụng cache vào avatar (nếu có dữ liệu)
            ApplyCachedData();
            Debug.Log($&quot;Avatar {recipe.name} đã được tải từ cache.&quot;);
        }
        else
        {
            // Tạo mới từ recipe
            avatar.LoadFromRecipe(recipe);
            // Đợi UMA tạo xong
            avatar.CharacterCreated.AddListener(OnCharacterCreated);
            avatar.BuildCharacter();
            // Đợi build hoàn tất
            yield return new WaitForSeconds(0.5f); // Tạm thời, thực tế nên dùng event
        }

        // Bước 4: Ghim xương (sau khi có umadata)
        if (umaData != null)
            PinBones();

        // Bước 5: Lưu cache (nếu chưa có hoặc force)
        if (!File.Exists(cachePath) || forceRecreateCache)
        {
            SaveCache(cachePath);
            Debug.Log($&quot;Đã lưu cache cho {recipe.name}&quot;);
        }

        bundle.Unload(false);
    }

    void OnCharacterCreated(UMAData data)
    {
        umaData = data;
        // Lưu cache ngay sau khi tạo
        string cacheKey = avatar.umaRecipe.recipeString.GetHashCode().ToString();
        string cachePath = Path.Combine(cacheFolder, cacheKey + &quot;.dat&quot;);
        if (!File.Exists(cachePath) || forceRecreateCache)
            SaveCache(cachePath);
    }

    // --- CACHE SYSTEM ---
    [System.Serializable]
    public class BoneCacheData
    {
        public string name;
        public Vector3 position;
        public Quaternion rotation;
        public Vector3 scale;
        public string parent;
    }

    [System.Serializable]
    public class AvatarCache
    {
        public string recipeName;
        public string raceName;
        public List&lt;BoneCacheData&gt; bones = new List&lt;BoneCacheData&gt;();
        public string wardrobeData; // Có thể lưu thêm wardrobe slots
        public string dnaData;
    }

    void SaveCache(string path)
    {
        if (umaData == null) return;
        AvatarCache cache = new AvatarCache();
        cache.recipeName = avatar.umaRecipe.recipeString;
        cache.raceName = avatar.umaRecipe.raceData.raceName;

        // Lấy tất cả xương từ umaBones
        foreach (var bone in umaData.umaRecipe.umaBones)
        {
            if (bone != null)
            {
                cache.bones.Add(new BoneCacheData
                {
                    name = bone.name,
                    position = bone.position,
                    rotation = bone.rotation,
                    scale = bone.scale,
                    parent = bone.parent?.name
                });
            }
        }

        // Lưu wardrobe và DNA (nếu cần)
        // cache.wardrobeData = avatar.umaRecipe.wardrobeSlots.ToString();
        // cache.dnaData = avatar.umaRecipe.raceData.dna.ToString();

        BinaryFormatter formatter = new BinaryFormatter();
        using (FileStream stream = new FileStream(path, FileMode.Create))
        {
            formatter.Serialize(stream, cache);
        }
    }

    void LoadCache(string path)
    {
        BinaryFormatter formatter = new BinaryFormatter();
        using (FileStream stream = new FileStream(path, FileMode.Open))
        {
            AvatarCache cache = formatter.Deserialize(stream) as AvatarCache;
            if (cache == null) return;

            // Tạo lại từ cache (cần có recipe)
            // Thực tế nên lưu cả recipe string để tái tạo
            // Ở đây ta chỉ lưu bone data để ghim, không tái tạo toàn bộ
            boneCache.Clear();
            foreach (var b in cache.bones)
            {
                boneCache[b.name] = b;
            }
        }
    }

    void ApplyCachedData()
    {
        // Áp dụng cache vào xương thực tế (nếu đã có umaData)
        if (umaData == null) return;
        foreach (var bone in umaData.umaRecipe.umaBones)
        {
            if (bone != null &amp;&amp; boneCache.ContainsKey(bone.name))
            {
                var cached = boneCache[bone.name];
                bone.position = cached.position;
                bone.rotation = cached.rotation;
                bone.scale = cached.scale;
            }
        }
        // Cập nhật mesh sau khi thay đổi xương
        umaData.Dirty(true, true, true);
    }

    // --- PIN BONES (siêu mạnh) ---
    void PinBones()
    {
        if (masterControl == null) return;
        if (umaData == null) return;

        // Xóa các constraint cũ
        foreach (var c in activeConstraints)
            if (c != null) Destroy(c);
        activeConstraints.Clear();

        // Lấy transform từ umaData
        Transform GetBoneTransform(string name)
        {
            GameObject go = umaData.GetBoneGameObject(UMAUtils.StringToHash(name));
            return go != null ? go.transform : null;
        }

        // Hàm ghim
        void Pin(string boneName)
        {
            Transform t = GetBoneTransform(boneName);
            if (t == null) return;
            var constraint = t.gameObject.AddComponent&lt;ParentConstraint&gt;();
            constraint.AddSource(new ConstraintSource { sourceTransform = masterControl, weight = 1 });
            constraint.constraintActive = true;
            constraint.locked = true;
            activeConstraints.Add(constraint);
            if (logDetailed) Debug.Log($&quot;Ghim {boneName} vào {masterControl.name}&quot;);
        }

        if (pinNeck) Pin(&quot;bone_Neck&quot;);
        if (pinHead) Pin(&quot;bone_Head&quot;);
        if (pinSpine) Pin(&quot;bone_Spine&quot;);
        if (pinHips) Pin(&quot;bone_Hips&quot;);

        Debug.Log($&quot;Đã ghim {activeConstraints.Count} xương.&quot;);
    }

    // --- CÔNG CỤ HỖ TRỢ ---
    public void ReloadAvatar()
    {
        forceRecreateCache = true;
        StartCoroutine(LoadAndSetupAvatar());
    }

    public void ClearCache()
    {
        if (Directory.Exists(cacheFolder))
        {
            Directory.Delete(cacheFolder, true);
            Directory.CreateDirectory(cacheFolder);
            Debug.Log(&quot;Đã xóa toàn bộ cache.&quot;);
        }
    }

    // Hàm này có thể gọi từ bên ngoài để ghim thêm xương
    public void PinExtraBone(string boneName, Transform target)
    {
        if (umaData == null) return;
        Transform t = umaData.GetBoneGameObject(UMAUtils.StringToHash(boneName))?.transform;
        if (t == null) return;
        var constraint = t.gameObject.AddComponent&lt;ParentConstraint&gt;();
        constraint.AddSource(new ConstraintSource { sourceTransform = target, weight = 1 });
        constraint.constraintActive = true;
        constraint.locked = true;
        activeConstraints.Add(constraint);
        Debug.Log($&quot;Ghim thêm {boneName} vào {target.name}&quot;);
    }

    // Xuất dữ liệu xương hiện tại ra JSON
    public void ExportCurrentBones(string path)
    {
        if (umaData == null) return;
        var list = new List&lt;BoneCacheData&gt;();
        foreach (var bone in umaData.umaRecipe.umaBones)
        {
            if (bone != null)
            {
                list.Add(new BoneCacheData
                {
                    name = bone.name,
                    position = bone.position,
                    rotation = bone.rotation,
                    scale = bone.scale,
                    parent = bone.parent?.name
                });
            }
        }
        string json = JsonUtility.ToJson(new { bones = list }, true);
        File.WriteAllText(path, json);
        Debug.Log($&quot;Xuất dữ liệu xương ra {path}&quot;);
    }
}</string>
